{
  "info": {
    "name": "PM Outsource API",
    "description": "Collection of basic requests for the PM & Outsource backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root - GET /",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": ["/"]
        }
      }
    },
    {
      "name": "List users - GET /api/users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "Create user - POST /api/users",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_firstname\": \"Jane\",\n  \"user_lastname\": \"Doe\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "Update user - PUT /api/users/:id",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_department\": \"Engineering\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "{{id}}"]
        }
      }
    },
    {
      "name": "Delete user - DELETE /api/users/:id",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "{{id}}"]
        }
      }
    }
  ]
}
